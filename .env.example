# LLM query interpreter (optional).
#
# Without LLM_API_KEY the search keeps working exactly as before: the feature
# is reported as "disabled" by /api/interpret and the UI never shows AI chips.
#
# Any OpenAI-compatible endpoint works — OpenAI, OpenRouter, Groq, Together,
# DeepSeek, a local Ollama (http://localhost:11434/v1) or LM Studio.
# Copy this file to `.env.local` and fill in the key.

# Base URL of the OpenAI-compatible API (no trailing slash).
LLM_BASE_URL=https://api.openai.com/v1

# API key. Leave empty to keep the feature off.
LLM_API_KEY=

# Model used to interpret queries. Small/fast models are plenty.
LLM_MODEL=gpt-4o-mini

# Template images (self-hosted, one <templateId>.webp per template).
# Default: /images, i.e. files in public/images/. To serve them from Cloudflare R2
# (or any CDN), set the public base URL here (no trailing slash needed). Its origin
# is added to the Content-Security-Policy img-src automatically. Rebuild after changing.
# NEXT_PUBLIC_IMAGE_BASE=https://images.example.com/templates
NEXT_PUBLIC_IMAGE_BASE=/images
